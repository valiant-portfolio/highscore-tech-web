# =============================================================================
# Highscore Tech — environment template
# =============================================================================
# Copy to `.env.local` and fill in the real values. The five "Required"
# variables must be set for the app to start; the rest fall back to sane
# defaults when missing.

# ── App ──────────────────────────────────────────────────────────────────────
# Required — used in canonical URLs, OG metadata, sitemap, robots.
NEXT_PUBLIC_APP_URL=https://highzcore.tech
# Optional — overrides the display name in <title> templates.
NEXT_PUBLIC_SITE_NAME=Highscore Tech

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
#   Project URL      → NEXT_PUBLIC_SUPABASE_URL
#   anon/public key  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role key → SUPABASE_SERVICE_ROLE_KEY   (keep secret)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Trading bot Supabase ─────────────────────────────────────────────────────
#   A SEPARATE project from the app above — the bot writes bot_* tables there so
#   its schema and write volume can never affect users/payments/staff.
#   Everything under /admin/trading-bot reads through these.
NEXT_PUBLIC_BOT_SUPABASE_URL=https://YOUR-BOT-PROJECT.supabase.co
NEXT_PUBLIC_BOT_SUPABASE_ANON_KEY=
BOT_SUPABASE_SERVICE_ROLE_KEY=

# ── ALATPay (WEMA Bank payment gateway) ──────────────────────────────────────
# Both are passed to the inline SDK in the browser, so both must be
# NEXT_PUBLIC_. The API key here is ALATPay's public key, not a server secret.
NEXT_PUBLIC_ALATPAY_BUSINESS_ID=
NEXT_PUBLIC_ALATPAY_API_KEY=
# Optional — override only when ALATPay rotates URLs or you point at sandbox.
# NEXT_PUBLIC_ALATPAY_SDK_URL=https://payment-checkout.alatpay.ng/AlatPay.js
# ALATPAY_API_BASE=https://apibox.alatpay.ng

# ── Staff portal session ─────────────────────────────────────────────────────
# HMAC secret for signing the staff-portal cookie and peppering the personal-
# email hash. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, falls back to SUPABASE_SERVICE_ROLE_KEY.
STAFF_SESSION_SECRET=

# ── Cron secret ──────────────────────────────────────────────────────────────
# Shared secret used by every /api/cron/* endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Your hosting platform's scheduled-function facility must POST to the cron
# endpoints with header `X-Cron-Secret: <CRON_SECRET>`. Common patterns:
#   • Netlify Scheduled Functions
#   • Vercel Cron (vercel.json)
#   • External: cron-job.org, EasyCron, etc.
CRON_SECRET=

# ── Hostinger SMTP (transactional email) ─────────────────────────────────────
# We send through Hostinger email. Google Workspace was retired: the per-seat
# cost was not worth it for transactional mail.
# When unset, the send helpers no-op + log to the server console so the rest
# of the app keeps working in local dev.
#
# 1. Create the mailbox in hPanel -> Emails -> highzcore.tech -> Create mailbox.
# 2. SMTP_USER must be a REAL MAILBOX, never an alias. An alias only receives
#    and forwards - it has no password and can never authenticate, so SMTP
#    returns a bare `535 authentication failed` no matter what you set.
#    Authenticate as the real mailbox and put the alias in EMAIL_FROM: the
#    server is happy to send as an alias of the account you logged in as.
# 3. Port 587 (STARTTLS) is the default and the safer choice: many networks and
#    ISPs block 465 and 25 to curb spam. 465 (implicit TLS) also works where
#    it is not blocked.
# 4. SMTP_PASSWORD is the MAILBOX password from hPanel. If it contains a #,
#    wrap the value in double quotes or everything after it is dropped.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=otung@highzcore.tech
SMTP_PASSWORD=

# The visible From: line, and where replies go. We send from a no-reply
# mailbox, so EMAIL_REPLY_TO must be a box a human actually opens — every
# message carries it unless the caller sets its own.
EMAIL_FROM=Highscore Tech <noreply@highzcore.tech>
EMAIL_ADMIN=admin@highzcore.tech
EMAIL_REPLY_TO=admin@highzcore.tech

# DNS NOTE: highzcore.tech uses NETLIFY DNS, so Hostinger's DNS panel is not
# authoritative. Add the MX / SPF / DKIM records Hostinger gives you in
# Netlify -> Domains -> highzcore.tech -> DNS records, NOT in hPanel.

# Legacy Gmail fallback. Only used when SMTP_USER/SMTP_PASSWORD are unset, so
# mail keeps flowing during the switch. Safe to delete once Hostinger is live.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# ── Telegram (trading-bot alerts) ────────────────────────────────────────────
# Same bot + chat the Python bot posts to. From trading_bot/.env.
# When unset the cron routes log and no-op instead of sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Highscore Studio ─────────────────────────────────────────────────────────
# Studio sells in USD worldwide, but ALAT by Wema settles in Naira — this is the
# rate used to convert a USD order into the NGN amount actually charged. The
# rate used is snapshotted onto each order, so changing it never rewrites an
# existing invoice. Defaults to 1600 when unset.
STUDIO_USD_NGN_RATE=1400

# Contact + delivery channels shown on the Studio pages. Each accepts either a
# full link (a wa.me/message/… click-to-chat link, or t.me/…) or a bare
# number / @handle.
NEXT_PUBLIC_STUDIO_WHATSAPP=https://wa.me/message/XXXXXXXXXXXX
NEXT_PUBLIC_STUDIO_TELEGRAM=@your_handle

# Where links from the main site point. Leave unset in production (it defaults
# to https://studio.highzcore.tech) and to /studio in local dev. Set it only if
# the Studio ever moves to a different host.
# NEXT_PUBLIC_STUDIO_URL=https://studio.highzcore.tech
